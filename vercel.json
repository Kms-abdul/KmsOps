{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/ads", "destination": "/ads.html" },
    { "source": "/product/:slug", "destination": "/product.html" }
  ]
}
